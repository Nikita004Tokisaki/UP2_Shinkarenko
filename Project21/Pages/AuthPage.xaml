<Page x:Class="Project21.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Метка и поле для логина -->
        <Label Content="Логин" Grid.Row="0" Grid.Column="0" Margin="10,0,0,0"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="0" Grid.Column="1" ToolTip="Введите ваш логин"/>

        <!-- Метка и поле для пароля -->
        <Label Content="Пароль" Grid.Row="1" Grid.Column="0" Margin="10,0,0,0"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" ToolTip="Введите ваш пароль"/>

        <!-- Кнопки действий -->
        <Button Content="Вход" Grid.Row="2" Grid.Column="1" Click="ButtonEnter_OnClick" ToolTip="Войти в систему"/>
        <Button Content="Регистрация" Grid.Row="3" Grid.Column="1" Click="ButtonReg_Click" ToolTip="Перейти на страницу регистрации"/>
    </Grid>
</Page>