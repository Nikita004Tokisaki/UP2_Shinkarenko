<Page x:Class="Project21.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Логин" Grid.Row="0" Grid.Column="0" Margin="10,0,0,0"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="0" Grid.Column="1" ToolTip="Придумайте логин"/>

        <Label Content="Пароль" Grid.Row="1" Grid.Column="0" Margin="10,0,0,0"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" ToolTip="Придумайте пароль"/>

        <Label Content="Подтверждение" Grid.Row="2" Grid.Column="0" Margin="10,0,0,0"/>
        <PasswordBox x:Name="PasswordBoxConfirm" Grid.Row="2" Grid.Column="1" ToolTip="Повторите пароль"/>

        <Label Content="ФИО" Grid.Row="3" Grid.Column="0" Margin="10,0,0,0"/>
        <TextBox x:Name="TextBoxFIO" Grid.Row="3" Grid.Column="1" ToolTip="Введите ваше ФИО"/>

        <Label Content="Роль" Grid.Row="4" Grid.Column="0" Margin="10,0,0,0"/>
        <ComboBox x:Name="CmbRole" Grid.Row="4" Grid.Column="1" SelectedIndex="1" ToolTip="Выберите роль">
            <ComboBoxItem Content="Администратор"/>
            <ComboBoxItem Content="Пользователь"/>
        </ComboBox>

        <Button Content="Зарегистрироваться" Grid.Row="5" Grid.Column="1" Click="ButtonReg_Click" ToolTip="Создать аккаунт"/>
    </Grid>
</Page>