<Page x:Class="Project21.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администратор" 
      IsVisibleChanged="Page_IsVisibleChanged" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Таблица (Шаг 7) -->
        <DataGrid x:Name="DataGridUser" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="200"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="130"/>
                <DataGridTextColumn Header="Ф.И.О." Binding="{Binding FIO}" Width="*"/>
                <DataGridTextColumn Header="Фото" Binding="{Binding Photo}" Width="150"/>
                <DataGridTemplateColumn Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="ButtonEdit_Click" Margin="2" Width="130"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Button Content="Добавить" Click="ButtonAdd_Click" ToolTip="Добавить нового пользователя"/>
            <Button Content="Удалить" Click="ButtonDel_Click" ToolTip="Удалить выбранные записи"/>
        </StackPanel>
    </Grid>
</Page>
