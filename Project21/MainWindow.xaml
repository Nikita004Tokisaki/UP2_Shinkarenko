<Window x:Class="Project21.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="650" Width="900" 
        Closing="Window_Closing" WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <!-- Разделение окна на 3 строки (Шаг 1) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Кнопка "Назад" в левом верхнем углу -->
        <Button x:Name="ButtonBack" Content="Назад" 
                HorizontalAlignment="Left" Margin="10,0,0,0" Width="75" 
                Click="ButtonBack_Click" ToolTip="Вернуться на предыдущую страницу"/>

        <!-- Фрейм для загрузки страниц (Авторизация, Регистрация и т.д.) -->
        <Frame x:Name="MainFrame" Grid.Row="1" 
               Source="/Pages/AuthPage.xaml" 
               NavigationUIVisibility="Hidden" 
               Navigated="MainFrame_OnNavigated"/>

        <!-- Вывод текущей даты и времени в правом нижнем углу -->
        <TextBlock x:Name="TextBlockDateTime" Grid.Row="2" 
                   HorizontalAlignment="Right" Margin="0,0,15,0" 
                   VerticalAlignment="Center"/>
    </Grid>
</Window>